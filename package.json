  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "~6.0.3",
    "vite": "^6.2.0",
    "vite-plugin-top-level-await": "^1.5.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@bytecodealliance/jco": "^1.39.0",
    "@bytecodealliance/preview2-shim": "^0.30.0",
    "lit": "^3.3.3"
  }
}

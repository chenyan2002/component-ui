{
  "name": "component-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "build": "tsc --noEmit && vite build",
    "build:bindgen": "scripts/build-bindgen.sh",
    "preview": "vite preview",
